{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}} {{method}} {{uri}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx / second",
      "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka listener rate",
      "id": 4,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {"expr": "sum by (application) (rate(spring_kafka_listener_seconds_count[1m]))", "legendFormat": "{{application}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox publications and failures",
      "id": 5,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {"expr": "rate(orderflow_outbox_published_total[1m])", "legendFormat": "published"},
        {"expr": "rate(orderflow_outbox_failures_total[1m])", "legendFormat": "failures"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Notification outcomes",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "rate(orderflow_notifications_processed_total[1m])", "legendFormat": "processed"},
        {"expr": "rate(orderflow_notifications_duplicates_total[1m])", "legendFormat": "duplicates"},
        {"expr": "rate(orderflow_notifications_simulated_failures_total[1m])", "legendFormat": "controlled failures"},
        {"expr": "rate(orderflow_notifications_dlt_total[1m])", "legendFormat": "DLT"}
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["orderflow", "spring-boot", "kafka"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "OrderFlow Overview",
  "uid": "orderflow-overview",
  "version": 1
}
